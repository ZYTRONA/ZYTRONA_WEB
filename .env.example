# ==========================================
# ZYTRONA WEB - Environment Variables Template
# ==========================================
# Copy this file to .env and replace placeholder values with your real credentials.
# DO NOT commit real secrets or credentials to GitHub.

# EmailJS Service Configuration (Used for consultation forms & client inquiries)
# Dashboard: https://dashboard.emailjs.com/
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
VITE_EMAILJS_TEMPLATE_ID_OWNER=your_owner_template_id_here
VITE_EMAILJS_TEMPLATE_ID_REPLY=your_reply_template_id_here
